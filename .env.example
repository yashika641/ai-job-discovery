# Copy this file to .env and fill in real values. Never commit .env.
#
# Gmail SMTP sender credentials. EMAIL_APP_PASSWORD must be a Google
# "App Password" (Google Account -> Security -> 2-Step Verification ->
# App passwords), NOT your normal Gmail login password.
EMAIL_SENDER=your.address@gmail.com
EMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Gemini API key, used to extract each new job's ranked skill list from its
# JD text (see gemini_extractor.py). Get one at https://aistudio.google.com/apikey.
# If left unset, the pipeline falls back to a plain keyword scan instead of
# failing.
GEMINI_API_KEY=xxxxxxxxxxxxxxxx
